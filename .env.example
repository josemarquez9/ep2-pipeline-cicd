# Copie este archivo como ".env" para ejecutar el sistema en su máquina:  cp .env.example .env
# El archivo .env NO se sube a Git (está en .gitignore). Nunca publique contraseñas reales.

COMPOSE_PROJECT_NAME=ep2-local
GATEWAY_PORT=8080

DB_NAME=productos
DB_USER=productos
DB_PASSWORD=cambie-esta-clave-local

# Escalabilidad: número de réplicas por servicio y recursos asignados a cada una
PRODUCTOS_REPLICAS=2
PRODUCTOS_CPUS=1.00
PRODUCTOS_MEMORY=768M
REPORTES_REPLICAS=2
REPORTES_CPUS=0.50
REPORTES_MEMORY=256M
