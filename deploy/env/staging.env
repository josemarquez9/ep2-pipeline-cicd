# Parámetros del entorno STAGING (sin secretos).
# El pipeline agrega en tiempo de ejecución: IMAGE_PREFIX, IMAGE_TAG, GIT_COMMIT, APP_VERSION, BUILD_TIME y DB_PASSWORD.
COMPOSE_PROJECT_NAME=ep2-staging
GATEWAY_PORT=8080
DB_NAME=productos
DB_USER=productos
PRODUCTOS_REPLICAS=2
PRODUCTOS_CPUS=1.00
PRODUCTOS_MEMORY=512M
REPORTES_REPLICAS=2
REPORTES_CPUS=0.50
REPORTES_MEMORY=256M
